{
  "name": "lunera",
  "version": "1.2.0",
  "description": "Reproductor de música",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "node scripts/build.js --publish never",
    "obfuscate": "node obfuscate.js",
    "restore": "node restore.js",
    "test": "node --test tests/appUpdater.test.js",
    "release": "node scripts/build.js --publish always"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@distube/ytdl-core": "^4.15.9",
    "all": "^0.0.0",
    "bcrypt": "^5.1.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.6.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "lyric-get": "^1.0.3",
    "node-fetch": "^2.6.7",
    "sqlite3": "^5.1.7",
    "undici": "^6.21.1",
    "usetube": "^2.0.2",
    "yt-dlp-exec": "^1.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "^7.1.0",
    "@capacitor/cli": "^7.0.1",
    "@capacitor/core": "^7.1.0",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "javascript-obfuscator": "^4.1.1"
  },
  "build": {
    "appId": "com.Lunera.electron",
    "productName": "Lunera",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/.bin",
      "!node_modules/electron",
      "!node_modules/electron-builder",
      "!backup/**/*",
      "!tests/**/*",
      "!scripts/**/*",
      "!.github/**/*",
      "!userData*.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@distube/ytdl-core/**/*",
      "node_modules/usetube/**/*",
      "node_modules/yt-dlp-exec/**/*",
      "node_modules/ffmpeg-static/**/*"
    ],
    "extraResources": [
      "node_modules/@distube/ytdl-core/**/*",
      "node_modules/usetube/**/*",
      "node_modules/yt-dlp-exec/**/*",
      "node_modules/ffmpeg-static/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/logo2.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Lunera-Setup-${version}.${ext}",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "iTheRoken",
        "repo": "RokMusic",
        "releaseType": "draft"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iTheRoken/RokMusic.git"
  }
}

{
  "name": "lunera",
  "version": "1.2.0",
  "description": "Reproductor de música",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "npm run obfuscate && electron-builder --win && npm run restore",
    "obfuscate": "node obfuscate.js",
    "restore": "node restore.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@distube/ytdl-core": "https://codeload.github.com/ToddyTheNoobDud/ytdl-core-stuff/tar.gz/refs/heads/master",
    "all": "^0.0.0",
    "bcrypt": "^5.1.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.6.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "lyric-get": "^1.0.3",
    "node-fetch": "^2.6.7",
    "sqlite3": "^5.1.7",
    "undici": "^6.21.1",
    "usetube": "^2.0.2",
    "yt-dlp-exec": "^1.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "^7.1.0",
    "@capacitor/cli": "^7.0.1",
    "@capacitor/core": "^7.1.0",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "javascript-obfuscator": "^4.1.1"
  },
  "build": {
    "appId": "com.Lunera.electron",
    "productName": "Lunera",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/.bin",
      "!node_modules/electron",
      "!node_modules/electron-builder"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@distube/ytdl-core/**/*",
      "node_modules/usetube/**/*",
      "node_modules/yt-dlp-exec/**/*",
      "node_modules/ffmpeg-static/**/*"
    ],
    "extraResources": [
      "node_modules/@distube/ytdl-core/**/*",
      "node_modules/usetube/**/*",
      "node_modules/yt-dlp-exec/**/*",
      "node_modules/ffmpeg-static/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/logo2.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Lunera Beta Setup.${ext}",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
